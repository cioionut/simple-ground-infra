#cloud-config
hostname: vm-k3s
timezone: Europe/Bucharest
# cloud-init must NOT manage /etc/hosts on these boxes.
# /etc/hosts is owned by Ansible (provision/tasks/lan-host-records.yml), which writes a
# marked block holding records the site resolver does not answer for (e.g. the local
# registry). `manage_etc_hosts: true` renders /etc/cloud/templates/hosts.<distro>.tmpl
# over the whole file, and cc_update_etc_hosts runs PER_ALWAYS, so the block would be
# wiped on every boot. Instance user-data outranks cloud.cfg.d, which is why this lives here.
# See docs/adr/0012-cloud-init-enabled-hosts-still-ansible-owned.md in the mycloud repo.
manage_etc_hosts: false
users:
  - name: k3suser
    # Included both: Debian uses 'sudo', Arch uses 'wheel'
    groups: [sudo, wheel]
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}
    # Add the sudo rule here as a list/array
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
package_update: true
package_upgrade: false
packages:
  - qemu-guest-agent
  - htop
runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - echo "done" > /tmp/cloud-config.done
final_message: "The system is finally up, after $UPTIME seconds"
ssh_pwauth: false
disable_root: true
preserve_hostname: true
